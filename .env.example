# Set this to the IPv4 address players reach. This is a documentation example.
QUETZAL_PUBLIC_IP=203.0.113.10
QUETZAL_BIND=0.0.0.0
QUETZAL_HTTP_PORT=8082

# Enabled tenants: 25tolife, tdu, wcc, commandos, snowblind, rsvpsp
# (comma-separated). The default 25 to Life relay pool overlaps TDU and WCC;
# when combining them in adaptive/relay mode, move that pool below to
# 30400-30527.
QUETZAL_GAMES=25tolife
QUETZAL_UID=1000
QUETZAL_GID=1000

# direct, adaptive, or relay. Blocked-direct adaptive fallback needs field testing.
QUETZAL_RELAY_MODE=adaptive
QUETZAL_RELAY_FIRST_PORT=30200
QUETZAL_RELAY_LAST_PORT=30327
QUETZAL_LOG_LEVEL=info

# Optional localized 25 to Life MOTD JSON. Read again on each client request.
# The path must be visible inside the container; see configs/25tolife.motd.json.
# QUETZAL_TTL_MOTD_FILE=/data/resources/25tolife.motd.json

# Raw packet capture is opt-in. Leave empty for normal operation.
QUETZAL_CAPTURE_DIR=

# Commandos: UDP 30060/30061, isolated state under tenants/commandos.
# Plain matches the observed stock US account-creation login packet.
QUETZAL_COMMANDOS_PAYLOAD_MODE=plain
QUETZAL_COMMANDOS_RELAY_MODE=adaptive
QUETZAL_COMMANDOS_RELAY_FIRST_PORT=30600
QUETZAL_COMMANDOS_RELAY_LAST_PORT=30727
# QUETZAL_COMMANDOS_BIND=0.0.0.0
# QUETZAL_COMMANDOS_PUBLIC_IP=203.0.113.10
# QUETZAL_COMMANDOS_AUTH_PORT=30060
# QUETZAL_COMMANDOS_SECURE_PORT=30061

# Optional TDU overrides. Stock physical ports are 30200/30201/8124/8122.
# Native service ports are logical destinations inside the encrypted tunnel.
# QUETZAL_TDU_BIND=0.0.0.0
# QUETZAL_TDU_PUBLIC_IP=203.0.113.10
# QUETZAL_TDU_DIRECTORY_PORT=9000
# QUETZAL_TDU_RESOURCE_PORT=9001
# QUETZAL_TDU_SESSION_PORT=9002
# QUETZAL_TDU_DENSITY_PORT=9003
# QUETZAL_TDU_USERMAP_PORT=9004
# Optional private protocol metadata generated from the supported disc for activity density.
# QUETZAL_TDU_ACTIVITY_CATALOG=/data/resources/activity-catalog.json
# Generated XML uses the client's defaults and issues no pending prize grants.
# Optional overrides must be mounted/private files available inside the container.
# QUETZAL_TDU_NETCONFIG=/data/resources/netconfig.xml
# QUETZAL_TDU_PRIZE=/data/resources/prize.xml

# Snowblind: UDP 13015/13016; adaptive peer relay UDP 30800-30927.
# Plain matches the observed US retail guest-login request.
QUETZAL_SNOWBLIND_PAYLOAD_MODE=plain
QUETZAL_SNOWBLIND_RELAY_MODE=adaptive
QUETZAL_SNOWBLIND_RELAY_FIRST_PORT=30800
QUETZAL_SNOWBLIND_RELAY_LAST_PORT=30927
# QUETZAL_SNOWBLIND_BIND=0.0.0.0
# QUETZAL_SNOWBLIND_PUBLIC_IP=203.0.113.10
# QUETZAL_SNOWBLIND_AUTH_PORT=13015
# QUETZAL_SNOWBLIND_SECURE_PORT=13016
